#!/usr/bin/env bash
# Prepare an orb for this repository: mise, the pinned toolchain, the venv.
set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v mise >/dev/null 2>&1; then
  curl -fsSL https://mise.run | sh
  export PATH="$HOME/.local/bin:$PATH"
fi

# Orb shells are login shells, so activation goes in .bash_profile as well.
for profile in "$HOME/.bashrc" "$HOME/.bash_profile"; do
  if ! grep -qs 'mise activate bash' "$profile"; then
    echo 'eval "$(mise activate bash)"' >>"$profile"
  fi
done

mise trust --yes
mise install
mise run bootstrap
