{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":maintainLockFilesWeekly",
    "abandonments:recommended",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)"
  ],
  "ignorePaths": ["**/node_modules/**", "docs/wayfinding/**/prototypes/**"],
  "dependencyDashboard": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>[^/]+)/hk@[^#]+#/(?<depType>Config|Builtins)\\.pkl"
      ],
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#/{{{depType}}}.pkl"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "description": "The integration runs on Home Assistant's interpreter, so the dev Python stays on the minor Home Assistant ships; raise this cap when Home Assistant moves.",
      "matchManagers": ["mise"],
      "matchPackageNames": ["python/cpython"],
      "allowedVersions": "/^3\\.14\\.[0-9]+$/"
    },
    {
      "description": "Home Assistant Core requirements enforced by hassfest must move with the Home Assistant package.",
      "matchManagers": ["homeassistant-manifest", "pep621"],
      "matchPackageNames": ["homeassistant", "pyotp"],
      "groupName": "Home Assistant dependency set",
      "groupSlug": "home-assistant-dependency-set"
    },
    {
      "description": "The pytest plugin and its Syrupy pin follow Home Assistant, as does Core's pyotp pin in the dev group. Do not update them independently.",
      "matchManagers": ["pep621"],
      "matchPackageNames": [
        "pyotp",
        "pytest-homeassistant",
        "syrupy"
      ],
      "enabled": false
    },
    {
      "description": "Home Assistant owns these exact pins, the runtime closure of the dev config's default_config; regenerate them when updating Home Assistant instead of updating them independently.",
      "matchManagers": ["pep621"],
      "matchPackageNames": [
        "aiodhcpwatcher",
        "aiodiscover",
        "aiohasupervisor",
        "aiousbwatcher",
        "async-upnp-client",
        "av",
        "bleak-retry-connector",
        "cached-ipaddress",
        "dbus-fast",
        "file-read-backwards",
        "gazetteer-matcher",
        "go2rtc-client",
        "ha-ffmpeg",
        "habluetooth",
        "hassil",
        "home-assistant-frontend",
        "home-assistant-intents",
        "infrared-protocols",
        "matter-ble-proxy",
        "matter-python-client",
        "mutagen",
        "openai",
        "pymicro-vad",
        "pyspeex-noise",
        "pyturbojpeg",
        "rf-protocols",
        "serialx"
      ],
      "enabled": false
    },
    {
      "description": "hk is pinned twice, once as a mise tool and once in the two package URLs at the top of hk.pkl, and the two have to move together or hk runs one version while validating its config against another.",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["jdx/hk"],
      "groupName": "hk",
      "groupSlug": "hk"
    },
    {
      "description": "mise keeps the dependency graph behind each npm tool in mise.lock under .mise/locks, and Renovate's mise manager regenerates it with each bump. Left on, the npm manager would also bump those package.json files alone, out of step with their aube-lock.yaml and mise.lock's digest",
      "matchFileNames": [".mise/locks/**"],
      "enabled": false
    }
  ]
}
